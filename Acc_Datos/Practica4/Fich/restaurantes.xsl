<?xml version="1.0" encoding="UTF-8"?>
<xsl:stylesheet version="1.0" xmlns:xsl="http://www.w3.org/1999/XSL/Transform">
<xsl:output method="html" encoding="UTF-8" indent="yes"/>
<xsl:template match="/">
<html><head><meta charset="UTF-8"/><title>Restaurantes</title><style>body{font-family:Arial;margin:30px;background:#f5f5f5}table{border-collapse:collapse;width:100%}th,td{border:1px solid #bbb;padding:8px;text-align:left}th{background:#dce9df}</style></head><body><h1>Listado de restaurantes</h1><table><tr><th>ID</th><th>Cadena</th><th>Activo</th><th>Empleados</th><th>Dirección</th><th>Facturación</th><th>Terraza</th></tr><xsl:for-each select="restaurantes/locales/restaurante"><tr><td><xsl:value-of select="id"/></td><td><xsl:value-of select="nombreCadena"/></td><td><xsl:value-of select="activo"/></td><td><xsl:value-of select="empleados"/></td><td><xsl:value-of select="direccion"/></td><td><xsl:value-of select="facturacion"/></td><td><xsl:value-of select="tieneTerraza"/></td></tr></xsl:for-each></table></body></html></xsl:template></xsl:stylesheet>